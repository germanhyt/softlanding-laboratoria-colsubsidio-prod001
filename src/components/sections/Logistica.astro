---
import { logistica } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
import MotionScope from "@components/islands/MotionScope";

const icons = {
  plane: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
  clock: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>`,
  calendar: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>`,
} as const;
---

<!--
  SoT: info/prototype/8_desktop_que-necesitas-para-participar.png
  Desktop: left panel gradient; photo fills right column WITHOUT left fade/crop.
  Mobile: height capped (asset is very tall) + soft top blend into panel.
  Asset: /assets/logistica/photo.webp
-->
<section
  id={logistica.id}
  class="logistica scroll-mt-24 overflow-hidden text-brand-neutral-white"
  aria-labelledby="logistica-heading"
>
  <div class="grid lg:grid-cols-2 lg:items-stretch">
    <div
      class="logistica-panel relative z-10 px-4 py-14 xs:py-16 sm:px-6 md:py-20 lg:px-10 lg:py-24 xl:px-16"
    >
      <MotionReveal client:visible>
        <h2
          id="logistica-heading"
          class="max-w-lg text-[1.65rem] font-bold leading-[1.15] tracking-tight xs:text-[1.85rem] sm:text-3xl md:text-4xl"
        >
          {logistica.headline}
        </h2>
      </MotionReveal>

      <MotionScope
        client:visible
        staggerDelay={0.1}
        className="mt-8 grid gap-4 md:grid-cols-2"
      >
        {
          logistica.cards.map((card, index) => {
            const spanClass =
              index === 2 ? "md:col-span-2" : "md:col-span-1";
            return (
              <article
                data-motion-item
                class={`rounded-[1.35rem] bg-brand-neutral-white p-5 text-brand-dark sm:rounded-2xl sm:p-6 ${spanClass}`}
              >
                <span class="inline-flex" set:html={icons[card.icon]} />
                <h3 class="mt-3 text-base font-bold sm:text-lg">{card.title}</h3>
                <ul class="mt-3 space-y-2">
                  {card.items.map((item) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-brand-dark/85 sm:text-base">
                      <span
                        class="mt-1 shrink-0 font-bold text-brand-magenta"
                        aria-hidden="true"
                      >
                        &gt;
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </MotionScope>
    </div>

    <MotionReveal
      client:visible
      variant="fade"
      delay={0.12}
      className="logistica-media relative w-full overflow-hidden max-lg:aspect-[4/3] max-lg:max-h-[360px] sm:max-lg:aspect-[16/11] sm:max-lg:max-h-[400px] lg:min-h-full"
    >
      <img
        src={logistica.image.src}
        alt={logistica.image.alt}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
        width="3549"
        height="1623"
      />
    </MotionReveal>
  </div>
</section>

<style>
  .logistica {
    background-color: #0b0b0b;
  }

  /* Gradient only on the content panel — never over the photo */
  .logistica-panel {
    background: linear-gradient(
      90deg,
      #0b0b0b 0%,
      #181818 35%,
      #2c2c2c 70%,
      #454545 100%
    );
  }

  @media (max-width: 1023px) {
    .logistica-panel {
      background: linear-gradient(
        180deg,
        #2a2a2a 0%,
        #1a1a1a 50%,
        #0f0f0f 100%
      );
    }
  }
</style>
