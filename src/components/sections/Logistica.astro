---
import { logistica } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
import MotionScope from "@components/islands/MotionScope";

const icons = {
  plane: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>`,
  clock: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>`,
  calendar: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-7 w-7 text-brand-magenta" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18"/></svg>`,
} as const;
---

<!--
  SoT: info/prototype/8_desktop_que-necesitas-para-participar.png
  Desktop: photo FULL WIDTH behind content + strong left black→transparent gradient.
  Mobile:  dark panel + stacked portrait (mobile.webp) + top vignette.
  Assets: desktop.webp / mobile.webp — never wrap media in MotionReveal.
-->
<section
  id={logistica.id}
  class="logistica relative scroll-mt-24 overflow-hidden text-brand-neutral-white"
  aria-labelledby="logistica-heading"
>
  <!-- Desktop full-bleed photo (entire section width) -->
  <div
    class="pointer-events-none absolute inset-0 z-0 hidden overflow-hidden lg:block"
    aria-hidden="true"
  >
    <img
      src={logistica.imageDesktop.src}
      alt=""
      class="logistica-photo h-full w-full object-cover"
      loading="lazy"
      width="3549"
      height="1623"
    />
    <!-- Left black vignette over the full-bleed photo -->
    <div class="logistica-shade absolute inset-0"></div>
  </div>

  <div class="container relative z-10">
    <!-- Content: transparent over gradient on desktop; solid dark on mobile -->
    <div
      class="logistica-panel py-14 xs:py-16 md:py-20 lg:max-w-[500px] lg:py-24 xl:max-w-[540px] xl:py-28"
    >
      <MotionReveal client:load variant="left">
        <h2
          id="logistica-heading"
          class="max-w-lg text-[1.65rem] font-bold leading-[1.15] tracking-tight xs:text-[1.85rem] sm:text-3xl md:text-4xl"
        >
          {logistica.headline}
        </h2>
      </MotionReveal>

      <MotionScope
        client:load
        variant="up"
        staggerDelay={0.07}
        className="mt-8 grid gap-4 md:grid-cols-2"
      >
        {
          logistica.cards.map((card, index) => {
            const spanClass =
              index === 2 ? "md:col-span-2" : "md:col-span-1";
            return (
              <article
                data-motion-item
                class={`rounded-[1.35rem] bg-brand-neutral-white p-5 text-brand-dark sm:rounded-2xl sm:p-6 ${spanClass}`}
              >
                <span class="inline-flex" set:html={icons[card.icon]} />
                <h3 class="mt-3 text-base font-bold sm:text-lg">{card.title}</h3>
                <ul class="mt-3 space-y-2">
                  {card.items.map((item) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-brand-dark/85 sm:text-base">
                      <span
                        class="mt-1 shrink-0 font-bold text-brand-magenta"
                        aria-hidden="true"
                      >
                        &gt;
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </MotionScope>
    </div>

    <!-- Mobile: portrait below cards + top black→transparent fade into the photo -->
    <div
      class="relative w-full overflow-hidden lg:hidden max-h-[420px] aspect-[11/14] sm:max-h-[460px]"
    >
      <img
        src={logistica.imageMobile.src}
        alt={logistica.imageMobile.alt}
        class="h-full w-full object-cover object-[center_35%]"
        loading="lazy"
        width="1230"
        height="4180"
      />
      <div class="logistica-shade-mobile pointer-events-none absolute inset-0" aria-hidden="true">
      </div>
    </div>
  </div>
</section>

<style>
  .logistica {
    background-color: #0f0f0f;
  }

  /* Mobile panel: solid dark under cards */
  .logistica-panel {
    background: linear-gradient(
      180deg,
      #1c1c1c 0%,
      #141414 55%,
      #0f0f0f 100%
    );
  }

  @media (min-width: 1024px) {
    /* Desktop: panel is transparent — shade lives on the photo */
    .logistica-panel {
      background: transparent;
    }
  }

  /* Desktop photo positioning — scale + translate shifts photo right so subjects sit clean on the right */
  .logistica-photo {
    object-position: 72% center;
    transform: scale(1.18) translate3d(10%, 0, 0);
    transform-origin: 72% center;
    will-change: transform;
  }

  @media (min-width: 1280px) {
    .logistica-photo {
      object-position: 75% center;
      transform: scale(1.22) translate3d(12%, 0, 0);
      transform-origin: 75% center;
    }
  }

  @media (min-width: 1536px) {
    .logistica-photo {
      object-position: 78% center;
      transform: scale(1.25) translate3d(14%, 0, 0);
      transform-origin: 78% center;
    }
  }

  /*
    Prototype desktop: photo spans full width; black fades left → transparent
    so cards stay readable and the subjects read on the right.
  */
  .logistica-shade {
    background: linear-gradient(
      90deg,
      #0f0f0f 0%,
      rgba(15, 15, 15, 0.98) 20%,
      rgba(15, 15, 15, 0.85) 32%,
      rgba(15, 15, 15, 0.3) 44%,
      rgba(15, 15, 15, 0.05) 54%,
      transparent 62%
    );
  }

  @media (min-width: 1280px) {
    .logistica-shade {
      background: linear-gradient(
        90deg,
        #0f0f0f 0%,
        rgba(15, 15, 15, 0.98) 18%,
        rgba(15, 15, 15, 0.82) 28%,
        rgba(15, 15, 15, 0.25) 40%,
        rgba(15, 15, 15, 0.04) 50%,
        transparent 58%
      );
    }
  }

  /* Mobile: blend dark panel → photo (top vignette on the image) */
  .logistica-shade-mobile {
    background: linear-gradient(
      180deg,
      #0f0f0f 0%,
      rgba(15, 15, 15, 0.85) 18%,
      rgba(15, 15, 15, 0.45) 42%,
      rgba(15, 15, 15, 0.12) 68%,
      transparent 100%
    );
  }
</style>
