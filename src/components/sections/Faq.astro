---
import { faq } from "@content/content";
import FaqAccordion from "@components/islands/FaqAccordion";
import MotionReveal from "@components/islands/MotionReveal";
---

<section
  id={faq.id}
  class="scroll-mt-24 bg-brand-neutral-white py-16 md:py-20 lg:py-24"
  aria-labelledby="faq-heading"
>
  <div class="container max-w-3xl">
    <MotionReveal client:visible>
      <h2
        id="faq-heading"
        class="text-left text-3xl font-bold tracking-tight text-brand-dark sm:text-4xl md:text-center"
      >
        {faq.headline}
      </h2>
    </MotionReveal>

    <MotionReveal client:visible delay={0.1} className="mt-8 md:mt-10">
      <FaqAccordion client:visible items={[...faq.items]} />
    </MotionReveal>
  </div>
</section>
