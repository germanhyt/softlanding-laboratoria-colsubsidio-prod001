---
import { conocenos } from "@content/content";
import MotionReveal from "@components/islands/MotionReveal";
---

<!--
  SoT:
  - Desktop: info/prototype/9_desktop_impulsando-desarrollo-profesional.png
  - Mobile:  info/prototype/9_mobile_impulsando-desarrollo-profesional.png

  Map always visible (not MotionReveal — opacity:0 hid the watermark).
  Asset is low-alpha grey; rendered as a solid silhouette via CSS mask.
-->
<section
  id={conocenos.id}
  class="conocenos relative scroll-mt-24 overflow-hidden bg-brand-neutral-white"
  aria-labelledby="conocenos-heading"
>
  <!-- LatAm map watermark — always painted, never opacity:0 -->
  <div class="conocenos-map" aria-hidden="true">
    <div class="conocenos-map__sil"></div>
  </div>

  <div
    class="container relative z-10 grid items-center gap-10 py-14 xs:py-16 md:py-20 lg:grid-cols-2 lg:gap-12 lg:py-24 xl:gap-16 xl:py-28"
  >
    <div class="relative z-10 max-w-xl">
      <MotionReveal client:load variant="left">
        <h2
          id="conocenos-heading"
          class="text-[1.65rem] font-bold leading-[1.15] tracking-tight text-brand-dark xs:text-[1.85rem] sm:text-[2.15rem] md:text-[2.35rem] lg:text-[2.5rem]"
        >
          {conocenos.headline}
        </h2>
      </MotionReveal>
      <MotionReveal client:load variant="left" delay={0.06}>
        <p
          class="mt-5 text-[0.9375rem] leading-[1.55] text-brand-dark sm:text-base md:text-[1.05rem] lg:text-lg lg:leading-[1.55]"
        >
          {conocenos.body}
        </p>
      </MotionReveal>
      <MotionReveal client:load variant="up" delay={0.1} className="mt-8">
        <a
          href={conocenos.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full bg-brand-yellow px-8 py-3 text-base font-bold text-brand-dark transition hover:bg-brand-yellow-soft"
        >
          {conocenos.cta.label}
        </a>
      </MotionReveal>
    </div>

    <MotionReveal client:load variant="right" delay={0.1} className="conocenos-art relative z-10">
      <img
        src={conocenos.image.src}
        alt={conocenos.image.alt}
        class="conocenos-art__img mx-auto block h-auto w-full max-w-md object-contain sm:max-w-lg lg:ml-auto lg:mr-0 lg:max-w-[560px] xl:max-w-[620px]"
        loading="lazy"
        width="720"
        height="640"
      />
    </MotionReveal>
  </div>
</section>

<style>
  .conocenos-map {
    pointer-events: none;
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 0;
    /* Wide enough so the silhouette is never clipped at xl/2xl */
    width: min(72vw, 560px);
    overflow: visible;
  }

  @media (min-width: 768px) {
    .conocenos-map {
      width: min(62vw, 680px);
    }
  }

  @media (min-width: 1024px) {
    .conocenos-map {
      width: min(58vw, 820px);
    }
  }

  @media (min-width: 1280px) {
    .conocenos-map {
      width: min(52vw, 920px);
    }
  }

  @media (min-width: 1536px) {
    .conocenos-map {
      width: min(48vw, 980px);
    }
  }

  /*
    PNG landmass is very low-alpha — paint a solid silhouette with mask.
    Position via mask-position (not translateX) so wide viewports never clip.
  */
  .conocenos-map__sil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #b8b8b8;
    -webkit-mask-image: url("/assets/conocenos/map-latam.png");
    mask-image: url("/assets/conocenos/map-latam.png");
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 8% center;
    mask-position: 8% center;
    opacity: 0.78;
  }

  @media (min-width: 1024px) {
    .conocenos-map__sil {
      -webkit-mask-position: 12% center;
      mask-position: 12% center;
      opacity: 0.72;
    }
  }

  @media (min-width: 1280px) {
    .conocenos-map__sil {
      -webkit-mask-position: 16% center;
      mask-position: 16% center;
    }
  }
</style>
