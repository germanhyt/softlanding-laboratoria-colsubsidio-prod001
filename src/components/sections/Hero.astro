---
import { hero, logos } from "@content/content";
import PostularCta from "@components/islands/PostularCta";
import MotionScope from "@components/islands/MotionScope";
import MotionReveal from "@components/islands/MotionReveal";
---

<!--
  SoT desktop: info/prototype/1_desktop_hero-banner.png
  - Text block left, ~3-line H1, generous gaps H1 → body → CTA
  - Strong black left-to-right vignette (not a flat wash)
  - Partner lockup: Colsubsidio taller than Laboratoria + "/"
  Mobile layout: full-bleed; Colsubsidio copy (ignore UTP stub in mobile PNG)
  Motion: copy stagger from left (mount); partner lockup rises up
-->
<section
  id={hero.id}
  class="hero relative isolate min-h-[100svh] overflow-hidden bg-brand-dark md:min-h-[min(800px,calc(100vh-2.5rem))] lg:min-h-[min(860px,calc(100vh-2.5rem))]"
  aria-labelledby="hero-heading"
>
  <!-- Photo always visible — never MotionReveal (opacity:0 hid media before) -->
  <div class="hero-media" aria-hidden="true">
    <picture class="hero-media__picture">
      <source media="(min-width: 768px)" srcset={hero.image.src} />
      <img
        src={hero.imageMobile.src}
        alt=""
        class="hero-media__photo"
      />
    </picture>
  </div>

  <!--
    Mobile: strong top→bottom black vignette (prototype 1_mobile).
    Solid near the header/copy, then fades into the photo.
  -->
  <div class="hero-shade-mobile absolute inset-0 z-[1] md:hidden" aria-hidden="true">
  </div>

  <!--
    Desktop: sombreado negro fuerte a la izquierda (prototype),
    opaco en el borde y fade hacia el centro-derecha — no un overlay uniforme.
  -->
  <div
    class="hero-shade-desktop absolute inset-0 z-[1] hidden md:block"
    aria-hidden="true"
  >
  </div>

  <div
    class="container relative z-10 flex min-h-[100svh] flex-col justify-center pb-28 pt-24 md:min-h-[min(800px,calc(100vh-4.5rem))] md:pb-32 md:pt-16 lg:min-h-[min(860px,calc(100vh-4.5rem))] lg:pb-36 lg:pt-24"
  >
    <!--
      Bloque de texto: ancho para ~3 líneas de H1 en desktop,
      espacios verticales generosos como el prototype.
    -->
    <MotionScope
      client:load
      trigger="mount"
      variant="left"
      staggerDelay={0.08}
      className="mb-[10rem] md:mb-[0rem]  max-w-[19.5rem] text-white xs:max-w-[22rem] sm:max-w-md md:max-w-[32rem] lg:max-w-[48rem] xl:max-w-[52rem]"
    >
      <h1
        id="hero-heading"
        data-motion-item
        class="text-[1.7rem] font-bold leading-[1.2] tracking-[-0.01em] text-white xs:text-[1.9rem] sm:text-[2.15rem] md:text-[2.5rem] md:leading-[1.18] lg:text-[2.85rem] xl:text-[3.05rem] xl:leading-[1.15]"
      >
        {hero.headline}
      </h1>
      <p
        data-motion-item
        class="mt-5 max-w-[48rem] text-[0.9375rem] font-normal leading-[1.55] text-white sm:mt-6 sm:text-base md:mt-6 md:text-[1.05rem] md:leading-[1.55] lg:mt-6 lg:text-[1.125rem] lg:leading-[1.55]"
      >
        {hero.subcopy}
      </p>
      <div data-motion-item>
        <PostularCta
          client:idle
          href={hero.cta.href}
          label={hero.cta.label}
          className="mt-8 inline-flex items-center rounded-full bg-brand-yellow px-9 py-3 text-[0.95rem] font-bold text-brand-neutral-black transition hover:bg-brand-yellow-soft sm:mt-9 sm:px-10 sm:py-3.5 sm:text-base md:mt-10"
        />
      </div>
    </MotionScope>

    <!--
      Lockup partners (prototype): Colsubsidio ~1.6–1.8× la altura de Laboratoria,
      alineados al baseline, con "/" blanco.
    -->
    <MotionReveal
      client:load
      trigger="mount"
      variant="up"
      delay={0.28}
      className="pointer-events-none absolute inset-x-0 bottom-0 z-10"
    >
      <div aria-label="Aliados del programa">
        <div
          class="container flex items-center gap-3 py-5 sm:gap-3.5 sm:py-6 md:gap-4 md:py-7 lg:py-8"
        >
          <img
            src={logos.colsubsidio.src}
            alt={logos.colsubsidio.alt}
            class="pointer-events-auto h-8 w-auto object-contain object-left sm:h-9 md:h-10 lg:h-[2.75rem] xl:h-12"
            loading="eager"
          />
          <span
            class="select-none text-lg font-light leading-none text-white/95 sm:text-xl md:text-2xl"
            aria-hidden="true">/</span
          >
          <img
            src={logos.laboWhite.src}
            alt={logos.laboWhite.alt}
            class="pointer-events-auto h-[0.95rem] w-auto object-contain object-left sm:h-[1.05rem] md:h-[1.2rem] lg:h-[1.35rem] xl:h-[1.45rem]"
            loading="eager"
          />
        </div>
      </div>
    </MotionReveal>
  </div>
</section>

<style>
  /*
    Hero background framing — explicit CSS (Tailwind arbitrary object-position
    was not reliably shifting the crop). Scale gives headroom so translate
    never exposes empty edges inside overflow:hidden.
  */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-media__picture,
  .hero-media__photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media__photo {
    object-fit: cover;
    will-change: transform;
  }

  /* Mobile — pan composition right; scale prevents edge gaps */
  @media (max-width: 767px) {
    .hero-media__photo {
      object-position: 50% 50%;
      transform: scale(1.2) translate3d(10%, 0, 0);
      transform-origin: 50% 50%;
    }
  }

  /* Desktop — shift focal point right for subjects + copy balance */
  @media (min-width: 768px) {
    .hero-media__photo {
      object-position: 74% 38%;
      transform: scale(1.14) translate3d(11%, 0, 0);
      transform-origin: 68% 38%;
    }
  }

  @media (min-width: 1280px) {
    .hero-media__photo {
      object-position: 78% 36%;
      transform: scale(1.16) translate3d(12%, 0, 0);
      transform-origin: 70% 36%;
    }
  }

  /* Mobile: top black band → fade into photo (1_mobile prototype) */
  .hero-shade-mobile {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.92) 18%,
      rgba(0, 0, 0, 0.78) 36%,
      rgba(0, 0, 0, 0.45) 52%,
      rgba(0, 0, 0, 0.18) 68%,
      rgba(0, 0, 0, 0.04) 82%,
      transparent 100%
    );
  }

  /* Desktop: left vignette */
  .hero-shade-desktop {
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.78) 18%,
      rgba(0, 0, 0, 0.55) 36%,
      rgba(0, 0, 0, 0.22) 52%,
      rgba(0, 0, 0, 0.05) 68%,
      rgba(0, 0, 0, 0) 78%
    );
  }

  @media (min-width: 1280px) {
    .hero-shade-desktop {
      background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.9) 0%,
        rgba(0, 0, 0, 0.8) 16%,
        rgba(0, 0, 0, 0.58) 32%,
        rgba(0, 0, 0, 0.28) 48%,
        rgba(0, 0, 0, 0.08) 62%,
        rgba(0, 0, 0, 0) 74%
      );
    }
  }
</style>
