---
import { siteConfig } from "@config/site.config";
import { footer, logos } from "@content/content";
---

<footer class="bg-brand-yellow">
  <div
    class="container flex flex-col items-start justify-between gap-4 py-6 sm:flex-row sm:items-center"
  >
    <a
      href={footer.homeHref}
      class="inline-flex items-center"
      aria-label="Laboratoria — inicio"
    >
      <img
        src={logos.laboBlack.src}
        alt={logos.laboBlack.alt}
        class="h-6 w-auto sm:h-7"
        width="160"
        height="20"
      />
    </a>
    <a
      href={siteConfig.conocenosUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-semibold text-brand-dark underline-offset-4 hover:underline"
    >
      {footer.conocenos.label}
    </a>
  </div>
</footer>
