---
import { siteConfig } from "@config/site.config";
import { footer, logos } from "@content/content";
---

<footer class="bg-brand-yellow">
  <div
    class="container flex flex-row items-center justify-between gap-4 py-4 sm:py-6"
  >
    <a
      href={footer.homeHref}
      class="inline-flex shrink-0 items-center"
      aria-label="Laboratoria — inicio"
    >
      <img
        src={logos.laboBlack.src}
        alt={logos.laboBlack.alt}
        class="h-5 w-auto sm:h-6 md:h-7"
        width="160"
        height="20"
      />
    </a>
    <a
      href={siteConfig.conocenosUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-semibold text-brand-dark underline-offset-4 hover:underline sm:text-sm"
    >
      {footer.conocenos.label}
    </a>
  </div>
</footer>
